POSTGRES_DB=bodega
POSTGRES_USER=bodega_admin
POSTGRES_PASSWORD=change_me_primary
REPLICATION_USER=bodega_replicator
REPLICATION_PASSWORD=change_me_replication
API_KEY=change_me_gateway
# Las aplicaciones construyen sus URLs PostgreSQL usando estas credenciales y
# los nombres internos db-primary y db-replica definidos en Docker Compose.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=8
# Destinos PostgreSQL para las aplicaciones
DB_PRIMARY_HOST=db-primary
DB_REPLICA_HOST=db-replica